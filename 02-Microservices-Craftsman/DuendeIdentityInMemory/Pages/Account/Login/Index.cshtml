@page
@model DuendeIdentityInMemory.Pages.Login.Index

<div class="login-page">
    <div class="lead">
        <h1>Вхід у CargoDelivery STS (03.2)</h1>
        <p>Оберіть обліковий запис для авторизації через Duende IdentityServer</p>
    </div>

    <partial name="_ValidationSummary" />

    <div class="row">

        @if (Model.View.EnableLocalLogin)
        {
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-header">
                        <h2>Локальний акаунт</h2>
                    </div>

                    <div class="card-body">
                        <form asp-page="/Account/Login/Index">
                            <input type="hidden" asp-for="Input.ReturnUrl" />

                            <div class="form-group">
                                <label asp-for="Input.Username"></label>
                                <input class="form-control" placeholder="Username (alice або bob)" asp-for="Input.Username" autofocus>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.Password"></label>
                                <input type="password" class="form-control" placeholder="Password (alice або bob)" asp-for="Input.Password" autocomplete="off">
                            </div>

                            @if (Model.View.AllowRememberLogin)
                            {
                                <div class="form-group">
                                    <div class="form-check">
                                        <input class="form-check-input" asp-for="Input.RememberLogin">
                                        <label class="form-check-label" asp-for="Input.RememberLogin">
                                            Запам'ятати вхід
                                        </label>
                                    </div>
                                </div>
                            }

                            <button class="btn btn-primary" name="Input.Button" value="login">Увійти</button>
                            <button class="btn btn-secondary" name="Input.Button" value="cancel">Скасувати</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="col-sm-6">
            @if (Model.View.VisibleExternalProviders.Any())
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h2>Зовнішні провайдери</h2>
                    </div>
                    <div class="card-body">
                        <ul class="list-inline">
                            @foreach (var provider in Model.View.VisibleExternalProviders)
                            {
                                <li class="list-inline-item">
                                    <a class="btn btn-secondary"
                                       asp-page="/ExternalLogin/Challenge"
                                       asp-route-scheme="@provider.AuthenticationScheme"
                                       asp-route-returnUrl="@Model.Input.ReturnUrl">
                                        @provider.DisplayName
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h2>Демо-акаунти (TestUsers)</h2>
                </div>
                <div class="card-body">
                    <p class="mb-2">Використовуйте одну з тестових обліковок:</p>
                    <ul class="mb-0">
                        <li><code>alice</code> / <code>alice</code> — <strong>SuperAdmin</strong>, <strong>User</strong></li>
                        <li><code>bob</code> / <code>bob</code> — <strong>User</strong></li>
                    </ul>
                </div>
            </div>
        </div>

        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="alert alert-warning">
                <strong>Некоректний запит входу</strong>
                Для цього запиту не налаштовано жодної схеми автентифікації.
            </div>
        }
    </div>
</div>
