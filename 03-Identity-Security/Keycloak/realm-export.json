{
  "realm": "DevRealmDrivers",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "SuperAdmin", "description": "Full platform administrator" },
      { "name": "User", "description": "Standard driver/dispatcher user" }
    ]
  },
  "clientScopes": [
    {
      "name": "drivers_management",
      "description": "Access to DriversManagement API",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "drivers_management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "drivers_management",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cargo_ordering",
      "description": "Access to CargoOrderingManager API",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "cargo_ordering-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "cargo_ordering",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "blog_management",
      "description": "Access to DriversBlogManagement API",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "blog_management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "blog_management",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "drivers_management.swagger",
      "name": "DriversManagement & Craftsman Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "drivers_management",
        "cargo_ordering",
        "blog_management"
      ]
    },
    {
      "clientId": "duende.federation",
      "name": "Duende IdentityServer OIDC Federation",
      "enabled": true,
      "publicClient": false,
      "secret": "duende-keycloak-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "webOrigins": [ "+" ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "drivers_management",
        "cargo_ordering",
        "blog_management"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Smith",
      "email": "AliceSmith@email.com",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "realmRoles": [ "SuperAdmin", "User" ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Smith",
      "email": "BobSmith@email.com",
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ],
      "realmRoles": [ "User" ]
    }
  ]
}
